@model PortalFerias.Models.Destino_BC

@{
    ViewData["Title"] = "Detalhes do Destino";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Logout" asp-controller="Admin" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-box-arrow-right"></i> Terminar Sessão
        </a>
    </div>
    <div class="main-wrapper p-0 overflow-hidden" style="max-width: 900px; margin: 0 auto;">

        <div class="bg-primary p-4 text-white text-center">
            <h2 class="mb-0" style="font-weight: 600; letter-spacing: 1px;">@Model.Pais</h2>
        </div>

        <div class="p-5">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h4 class="text-muted mb-3" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px;">
                        Descrição do Pacote
                    </h4>
                    <p style="font-size: 1.15rem; line-height: 1.8; color: #444;">
                        @Model.Descricao
                    </p>
                </div>

                <div class="col-md-5 text-center mt-4 mt-md-0">
                    <div class="p-4 bg-light" style="border-radius: 20px; border: 2px dashed #0d6efd;">
                        <span class="text-muted d-block mb-1">Preço Total</span>
                        <h3 class="text-primary" style="font-weight: 700; font-size: 2.5rem;">
                            @Model.Preco.ToString("N2") &nbsp;€
                        </h3>
                    </div>
                </div>
            </div>

            <hr class="my-5" />

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Lista" class="btn btn-outline-secondary px-4" style="border-radius: 50px;">
                    <i class="bi bi-arrow-left"></i> Voltar à Lista
                </a>

                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info text-white px-4 shadow-sm" style="border-radius: 50px; font-weight: 600;">
                        <i class="bi bi-pencil-square"></i> Editar Destino
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>