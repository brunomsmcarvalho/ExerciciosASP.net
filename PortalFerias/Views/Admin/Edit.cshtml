@model PortalFerias.Models.Destino_BC

@{
    ViewData["Title"] = "Editar Destino";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Logout" asp-controller="Admin" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-box-arrow-right"></i> Terminar Sessão
        </a>
    </div>

    <div class="main-wrapper p-5" style="text-align: left; max-width: 800px; margin-bottom: 50px;">
        <h2 class="titulo-home mb-4">Editar Destino</h2>
        <hr />

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-4">
                <label asp-for="Pais" class="control-label fw-bold mb-2">País</label>
                <input asp-for="Pais" class="form-control" style="border-radius: 10px; padding: 12px;" />
                <span asp-validation-for="Pais" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Descricao" class="control-label fw-bold mb-2">Descrição</label>
                <textarea asp-for="Descricao" class="form-control" rows="5" style="border-radius: 10px; padding: 12px;"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Preco" class="control-label fw-bold mb-2">Preço (€)</label>
                <input asp-for="Preco" class="form-control" style="border-radius: 10px; padding: 12px;" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="form-group mt-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-5 shadow-sm" style="border-radius: 50px; font-weight: 600;">
                    <i class="bi bi-save"></i> Guardar
                </button>
                <a asp-action="Lista" class="btn btn-outline-secondary px-5" style="border-radius: 50px;">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        /* Este script corrige o erro de validação do Preço.
           Ele permite que o jQuery Validation aceite tanto o ponto como a vírgula
           como separadores decimais antes de enviar o formulário.
        */
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        }
    </script>
}