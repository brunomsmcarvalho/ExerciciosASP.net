@model IEnumerable<PortalFerias.Models.Destino_BC>

@{
    ViewData["Title"] = "Lista de Destinos";
}

<div class="container-admin">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="titulo-home" style="font-size: 2rem; margin: 0;">Página Administração</h2>
            <small class="text-muted">Gestão de pacotes de férias</small>
        </div>
        <a asp-action="Logout" asp-controller="Admin" class="btn btn-outline-danger shadow-sm">
            <i class="bi bi-box-arrow-right"></i> Terminar Sessão
        </a>
    </div>

    <hr />

    <div class="mb-4">
        <a asp-action="Create" class="btn btn-dark px-4 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Novo Destino
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 150px;">País</th>
                    <th>Descrição</th>
                    <th style="width: 130px;">Preço</th>
                    <th style="width: 150px;" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">
                            @Html.DisplayFor(modelItem => item.Pais)
                        </td>
                        <td class="text-muted" style="max-width: 400px; font-size: 0.9rem;">
                            @Html.DisplayFor(modelItem => item.Descricao)
                        </td>
                        <td class="text-nowrap fw-bold text-primary">
                            @item.Preco.ToString("N2") &nbsp;€
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm" title="Ver Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>