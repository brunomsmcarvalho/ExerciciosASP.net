@model Exercicio14ASP.Models.Conteudo
@{
    ViewData["Title"] = "Create";
    Layout = "_LayoutAdmin";
}

<link href="~/richtexteditor/rte_theme_default.css" rel="stylesheet" />
<script src="~/richtexteditor/rte.js"></script>
<script src="~/richtexteditor/plugins/all_plugins.js"></script>

<h1>Nova página</h1>
<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" method="post" id="formCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Pagina" class="control-label"></label>
                <input asp-for="Pagina" class="form-control" />
                <span asp-validation-for="Pagina" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Titulo" class="control-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Texto" class="control-label"></label>
                <!-- Div vazio para o editor -->
                <div id="div_editor_wrapper"></div>
                <!-- Campo hidden real que vai para o servidor -->
                <textarea asp-for="Texto" id="textoHidden" style="display:none;"></textarea>
                <span asp-validation-for="Texto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Autor" class="control-label"></label>
                <input asp-for="Autor" class="form-control" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Data" class="control-label"></label>
                <input asp-for="Data" class="form-control" />
                <span asp-validation-for="Data" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Admin" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

<script>
    var editor1 = null;

    // Esperar o DOM carregar completamente
    document.addEventListener('DOMContentLoaded', function() {

        // Configuração do editor
        var config = {
            height: '350px'
        };

        // Inicializar editor no div wrapper
        editor1 = new RichTextEditor("#div_editor_wrapper", config);

        // Interceptar o submit do formulário
        document.getElementById('formCreate').addEventListener('submit', function(e) {
            // Obter o HTML do editor
            var htmlContent = editor1.getHTMLCode();

            // DEBUG - ver o que está a ser copiado
            console.log('Conteúdo do editor:', htmlContent);

            // Colocar no textarea hidden
            document.getElementById('textoHidden').value = htmlContent;

            // Deixar o form submeter normalmente
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}