@model IEnumerable<Exercicio14ASP.Models.Conteudo>
@{
    ViewData["Title"] = "Gestão páginas";
    Layout = "_LayoutAdmin";
}
<h1>Gestão páginas</h1>
<p>
    <a asp-action="Create" class="btn btn-success">Nova página</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Página</th>
            <th>Título</th>
            <th>Texto</th>
            <th>Autor</th>
            <th>Data</th>
            <th style="width: 200px;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Pagina)</td>
                <td>
                    <div class="text-truncate-table">
                        @Html.Raw(item.Titulo)
                    </div>
                </td>
                <td>
                    <!-- CORRIGIDO - sem title -->
                    <div class="text-truncate-table">
                        @Html.Raw(item.Texto)
                    </div>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Autor)</td>
                <td>@Html.DisplayFor(modelItem => item.Data)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>