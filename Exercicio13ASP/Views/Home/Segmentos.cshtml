@model IEnumerable<Exercicio13ASP.Models.Segmentos>

@{
    ViewData["Title"] = "Segmentos";
}

<h1>Segmentos</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SegmentoNome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>Visualizar</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SegmentoNome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                @*<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>*@

                <a class="btn btn-outline-dark" asp-action="Destinos" asp-route-id="@item.Id">Ver Destinos</a>
            </td>
        </tr>
}
    </tbody>
</table>
