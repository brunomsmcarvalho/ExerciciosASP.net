@model Exercicio12ASP.Models.Cliente

@{
    ViewData["Title"] = "Details";
}

<h1 style="color:white">Detalhes</h1>

<div style="background: rgba(255,255,255,0.7); border-radius: 10px; padding: 20px;">
    <h4>Cliente</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Morada)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Morada)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
    </dl>
</div>
<br />  
<div>
    <a asp-action="Edit" style="background: rgba(255,255,255,0.8); border-radius: 10px; padding: 20px;color:black; text-decoration:none;" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index" style="background: rgba(255,255,255,0.8); border-radius: 10px; padding: 20px;color:black; text-decoration:none;">Voltar a clientes!</a>
</div>
