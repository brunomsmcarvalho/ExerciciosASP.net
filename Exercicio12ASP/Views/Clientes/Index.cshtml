@model IEnumerable<Exercicio12ASP.Models.Cliente>

@{
    ViewData["Title"] = "Index";
}

<h1 style="color:white">Clientes</h1>

<p>
    <a asp-action="Create" style="color: white;text-decoration:none;font-size:20px">Criar Novo</a>
</p>
<div style="background: rgba(255,255,255,0.8); border-radius: 10px; padding: 20px;">
    <table class="table" style="background: transparent;">
        <thead>
            <tr>
                <th style="background: transparent;">@Html.DisplayNameFor(model => model.Nome)</th>
                <th style="background: transparent;">@Html.DisplayNameFor(model => model.Morada)</th>
                <th style="background: transparent;">@Html.DisplayNameFor(model => model.Email)</th>
                <th style="background: transparent;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="background: transparent;">@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td style="background: transparent;">@Html.DisplayFor(modelItem => item.Morada)</td>
                    <td style="background: transparent;">@Html.DisplayFor(modelItem => item.Email)</td>
                    <td style="background: transparent;">
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
